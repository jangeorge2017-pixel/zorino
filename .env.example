# Zorino Environment Variables
#
# AUTHORITY HIERARCHY:
#   1. Vercel Production Environment Variables — AUTHORITATIVE for production
#   2. .env.local — LOCAL DEVELOPMENT ONLY (same variable names, real values for dev)
#   3. This file (.env.example) — DOCUMENTATION ONLY (no real secrets)
#
# Do NOT commit real secrets. Do NOT use .env.vercel as a runtime source.
# See https://vercel.com/docs/projects/environment-variables

# ── Supabase ────────────────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://zorino.org

# ── Security ────────────────────────────────────────────────────────
# Required in production: protects /api/cron/* (Authorization: Bearer <secret>)
CRON_SECRET=

# ── Notifications (optional) ────────────────────────────────────────
# NOTIFICATION_FROM_EMAIL=notifications@zorino.org
# RESEND_API_KEY=

# ── Mock catalog toggle (optional) ──────────────────────────────────
# SYNC_USE_MOCK=true

# ── AliExpress ──────────────────────────────────────────────────────
# https://developers.aliexpress.com/en/appKey.htm
# ALIEXPRESS_APP_KEY=
# ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_TRACKING_ID=your_aliexpress_tracking_id
# ALIEXPRESS_AFFILIATE_BASE_URL=https://s.click.aliexpress.com/deep_link.htm

# ── eBay Partner Network (EPN) ─────────────────────────────────────
# Developer keys: https://developer.ebay.com/my/keys
# ePN Campaign ID: https://partnernetwork.ebay.com/
# EBAY_APP_ID=          # Client ID (App ID) - Production: *-PRD-* ; Sandbox: *-SBX-*
# EBAY_CERT_ID=         # Client Secret (Cert ID)
# EBAY_CAMPAIGN_ID=     # ePN Campaign ID (affiliate tracking)
# EBAY_OAUTH_TOKEN=     # Optional - leave empty for auto client-credentials OAuth
# EBAY_REFERENCE_ID=    # Optional sub-tracking ID
# EBAY_SANDBOX=false      # Set to false in Production (auto-detected from PRD keys when omitted)
# EBAY_VERIFICATION_TOKEN=   # Required for Production keyset (account deletion notifications)
# EBAY_NOTIFICATION_ENDPOINT_URL=https://www.zorino.org/api/ebay/notifications

# ── Amazon Associates ───────────────────────────────────────────────
# https://webservices.amazon.com/paaapi/
# AMAZON_CREATORS_CLIENT_ID=
# AMAZON_CREATORS_CLIENT_SECRET=
# AMAZON_ASSOCIATE_TAG=
# AMAZON_CREATORS_VERSION=3.1

# ── Admitad Publisher API ──────────────────────────────────────────
# https://www.admitad.com/en/webmaster/profile/ → "Show credentials"
# ADMITAD_CLIENT_ID=
# ADMITAD_CLIENT_SECRET=
# ADMITAD_FEED_URL=      # Required: XML export URL from Admitad dashboard

# ── ArabClicks ─────────────────────────────────────────────────────
# https://arabclicks.com/ → publisher dashboard → "Product Feed"
# ARABCLICKS_FEED_URL=   # Required: universal product feed URL (CSV or XML)
# ARABCLICKS_API_KEY=
# ARABCLICKS_PUBLISHER_ID=

# ── CJdropshipping ─────────────────────────────────────────────────
# https://developers.cjdropshipping.com/
# CJDROPSHIPPING_API_KEY=

# ── Walmart (placeholder — not yet configured) ─────────────────────
# WALMART_API_KEY=
# WALMART_AFFILIATE_ID=

# ── Temu (placeholder — not yet configured) ────────────────────────
# TEMU_API_KEY=
# TEMU_AFFILIATE_ID=

# ── Best Buy (placeholder — not yet configured) ────────────────────
# BESTBUY_API_KEY=

# ── Noon (placeholder — not yet configured) ────────────────────────
# NOON_API_KEY=
# NOON_UAE_AFFILIATE_ID=
# NOON_KSA_AFFILIATE_ID=

# ── Jumia (placeholder — not yet configured) ───────────────────────
# JUMIA_API_KEY=
# JUMIA_AFFILIATE_ID=

# ── Shopify (placeholder — not yet configured) ─────────────────────
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=

# ── Data Layer (optional overrides) ─────────────────────────────────
# DATA_LAYER_ENABLED=true
# DATA_LAYER_CACHE_TTL_MS=300000
# DATA_LAYER_RATE_LIMIT_PER_MIN=60
# DATA_LAYER_MAX_RETRIES=3
# DATA_LAYER_RETRY_BASE_MS=500
# DATA_LAYER_QUEUE_MAX_PENDING=100
# DATA_LAYER_LOG_LEVEL=info

# ── Cron execution budget (Render background sync) ───────────────────
# Total wall-clock budget per /api/cron/* invocation. Default 1800000 (30 min).
# Keep below Render's 100-minute HTTP response ceiling. Vercel deployments must
# keep this under the serverless cap (e.g. 50000).
# CRON_BUDGET_MS=1800000
# CRON_MIN_STEP_BUDGET_MS=12000
# CRON_SYNC_STEP_BUDGET_MS=900000
# CRON_ADMITAD_STEP_BUDGET_MS=900000
# CRON_ADMITAD_BACKFILL_STEP_BUDGET_MS=300000
# CRON_ALIEXPRESS_STEP_BUDGET_MS=600000
# CRON_AMAZON_STEP_BUDGET_MS=600000
# CRON_PHASE1_STEP_BUDGET_MS=600000
# CRON_CATALOG_STEP_BUDGET_MS=300000
# CRON_NOON_STEP_BUDGET_MS=300000
# CRON_JUMIA_STEP_BUDGET_MS=300000
# CRON_ARABCLICKS_STEP_BUDGET_MS=600000
# ADMITAD_MAX_FEEDS=20
# ADMITAD_MAX_PRODUCTS_PER_FEED=2000

# ── Background worker (Render service: zorino-worker) ────────────────
# SYNC_CRON_URL=https://zorino-web.onrender.com
# WORKER_JOBS=/api/cron/refresh,/api/cron/sync
# WORKER_INTERVAL_MS=3600000
# WORKER_RUN_ON_START=true
# WORKER_REQUEST_TIMEOUT_MS=2100000
# WORKER_RETRY_ATTEMPTS=3
# WORKER_RETRY_DELAY_MS=30000
